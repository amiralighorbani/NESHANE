[TEMPLATE]
# ---------------------------------------------------------------------------
# نشانه — نمونهٔ متغیرهای محیطی
#
# این فایل را به `.env` کپی کن و مقدارها را پر کن:
#
#     cp .env.example .env        (لینوکس/مک)
#     copy .env.example .env      (ویندوز)
#
# `.env` در .gitignore است و کامیت نمی‌شود. هیچ رمز و کلیدی در سورس پروژه نیست.
# اگر متغیری را در محیط سرور ست کنی، همان بر `.env` اولویت دارد.
# ---------------------------------------------------------------------------

# --- پنل مدیریت (اجباری) ----------------------------------------------------
# نام کاربری مدیر
NESHANE_ADMIN_USER=
# رمز مدیر. می‌توانی جای این، فقط هش بدهی (پایین‌تر را ببین).
NESHANE_ADMIN_PASSWORD=
# مسیر مخفی پنل؛ یک رشتهٔ تصادفی بگذار تا از اسکنرها پنهان بماند.
# اگر خالی باشد، مسیر پیش‌فرض «/panel/» استفاده می‌شود و رمزی هم وجود ندارد
# که کسی بتواند حدس بزند (ورود با رمزِ تنظیم‌نشده بسته است).
NESHANE_ADMIN_PATH=/

# اگر نمی‌خواهی رمز به‌صورت متن ساده در .env باشد، فقط هش را بگذار:
#   python -c "from app import admin_auth; print(admin_auth.make_hash('رمز-تو'))"
#   NESHANE_ADMIN_PASSWORD_HASH=<هش>
#   NESHANE_ADMIN_PASSWORD_SALT=<نمک>
# (PBKDF2-SHA256، ۲۶۰٫۰۰۰ تکرار)

# --- مدل زبانی (اختیاری) ----------------------------------------------------
# اگر کلیدی نگذاری، اپ بدون خطا و با متن پایه کار می‌کند؛ فقط تفسیر شخصی‌سازی‌شده
# ساخته نمی‌شود. ارائه‌دهندهٔ اصلی جمینای است و در صورت خطا به گروک (Groq) می‌رود.
NESHANE_GEMINI_KEY=
NESHANE_GROQ_KEY=

# --- اختیاری ---------------------------------------------------------------
# NESHANE_DB=data/neshane.sqlite3      مسیر دیتابیس SQLite
# NESHANE_SHOW_OTP=1                   نمایش کد یک‌بارمصرف روی صفحه (فقط آزمون)
# NESHANE_LLM=0                        خاموش‌کردن کامل مدل زبانی
# NESHANE_GEMINI_MODEL=gemini-2.0-flash
# NESHANE_GROQ_MODEL=openai/gpt-oss-120b
# NESHANE_GEMINI_BASE=https://generativelanguage.googleapis.com/v1beta
# NESHANE_GROQ_BASE=https://api.groq.com/openai/v1
# NESHANE_LLM_TIMEOUT=15               مهلت هر درخواست به مدل (ثانیه)
# NESHANE_LLM_BREAKER=5                مدت بازبودن مدارشکن پس از خطای قطعی (دقیقه)
# NESHANE_LLM_PROXY=                   پروکسی برای عبور از فیلتر/تحریم منطقه‌ای (socks5:// هم، با PySocks)
# NESHANE_ENV_FILE=                    مسیر فایل دیگری به‌جای .env

# --- تبلیغات (اختیاری) ------------------------------------------------------
# سقف کلّی پاپ‌اپ، مستقل از تنظیم هر تبلیغ. صفر یعنی بی‌سقف.
# NESHANE_AD_COOLDOWN_MINUTES=45       بین دو پاپ‌اپ برای یک نفر حداقل چند دقیقه فاصله باشد
# NESHANE_AD_POPUPS_PER_DAY=4          هر نفر در شبانه‌روز حداکثر چند پاپ‌اپ ببیند
# NESHANE_ADS_DIR=data/ads_media       پوشهٔ رسانهٔ تبلیغ‌ها

# --- مالکیت دامنه برای اپ اندروید (اختیاری) --------------------------------
# `/.well-known/assetlinks.json` را پر می‌کند تا اپ اندرویدِ ساخته‌شده تمام‌صفحه
# و بدون نوار آدرس باز شود. چند مقدار را با کاما جدا کن. اگر اپ را با یک ابزار
# تحت وب ساختی، نام بسته و اثر انگشت SHA-256 همان خروجی را اینجا بگذار.
# NESHANE_APP_PACKAGE=app.neshane
# NESHANE_APP_SHA256=AA:BB:CC:DD:...
